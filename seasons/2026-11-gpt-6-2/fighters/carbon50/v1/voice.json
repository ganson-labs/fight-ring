{
  "description": "Глубокий, бархатный аристократический мужской баритон с лёгкой театральной хрипотцой старого Петербурга. Говорит неспешно, учтиво, с холодной иронией дуэлянта и затаённым гулом пламени за чугунной решёткой, в ударах — резко и властно.",
  "language": "ru",
  "lines": [
    {
      "id": "intro_1",
      "kind": "intro",
      "text": "Добрый вечер, любезный. На сегодня ваш фитиль сочтён."
    },
    {
      "id": "intro_2",
      "kind": "intro",
      "text": "Туман густеет. Позвольте проводить вас во тьму."
    },
    {
      "id": "taunt_1",
      "kind": "taunt",
      "text": "Не суетитесь — мостовая всех уравняет."
    },
    {
      "id": "taunt_2",
      "kind": "taunt",
      "text": "И это ваш лучший выпад? Право, скучно."
    },
    {
      "id": "taunt_3",
      "kind": "taunt",
      "text": "Подойдите ближе к свету, не робейте."
    },
    {
      "id": "super_1",
      "kind": "super",
      "text": "Спокойной ночи, сударь. Гашу последний фонарь!"
    },
    {
      "id": "super_2",
      "kind": "super",
      "text": "Полночь пробила! В пепел и копоть!"
    },
    {
      "id": "hit_1",
      "kind": "hit",
      "text": "В самое стекло!"
    },
    {
      "id": "hit_2",
      "kind": "hit",
      "text": "Точно в цель!"
    },
    {
      "id": "hit_3",
      "kind": "hit",
      "text": "Латунь не прощает!"
    },
    {
      "id": "hit_spark",
      "kind": "other",
      "text": "Ловите искру!"
    },
    {
      "id": "hit_whirl",
      "kind": "other",
      "text": "Закружит метель!"
    },
    {
      "id": "hit_shatter",
      "kind": "other",
      "text": "Вдребезги!"
    },
    {
      "id": "hit_ice",
      "kind": "other",
      "text": "По невскому льду!"
    },
    {
      "id": "hit_star",
      "kind": "other",
      "text": "Сверху — гаси!"
    },
    {
      "id": "hurt_1",
      "kind": "hurt",
      "text": "Трещина в плафоне…"
    },
    {
      "id": "victory_1",
      "kind": "victory",
      "text": "Фитиль догорел. Благодарю за поединок, сударь."
    },
    {
      "id": "victory_2",
      "kind": "victory",
      "text": "Улица чиста, фонари горят. До следующей ночи."
    },
    {
      "id": "defeat_1",
      "kind": "defeat",
      "text": "Пламя дрогнуло… но до рассвета я ещё вернусь."
    }
  ]
}

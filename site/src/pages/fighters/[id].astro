---
import Page from '../../layouts/Page.astro';
import Figure from '../../components/Figure.astro';
import MatchCard from '../../components/MatchCard.astro';
import { agentName, allFighters, playAgainst, roundTitle, seasons, setAgainst } from '../../data/ring';
import type { Fighter, MoveSlot, Season, StatKey } from '../../data/ring';
import { commandGlyphs } from '../../lib/command';
import { to } from '../../lib/paths';
import { rigDir, stageBackdrop } from '../../lib/rig';

export async function getStaticPaths() {
  const all = await seasons();
  return (await allFighters()).map((fighter) => ({ params: { id: fighter.id }, props: { fighter, all } }));
}
interface Props { fighter: Fighter; all: Season[] }
const { fighter: f, all } = Astro.props;
const seasonOf = (id: string) => all.find((s) => s.id === id) as Season;
// a fighter of the roster is one version; a list of one item with nothing in it says nothing
const history = f.versions.length > 1 || f.versions.some((v) => v.rounds.length > 0 || v.note);
const path = Astro.url.pathname;

const STATS: [StatKey, string][] = [['health', 'Здоровье'], ['power', 'Сила'], ['speed', 'Скорость'], ['defense', 'Защита']];
const SLOTS: [MoveSlot, string][] = [['super', 'Суперприём'], ['special', 'Спецприёмы'], ['normal', 'Обычные удары']];
const groups = SLOTS.map(([slot, title]) => ({ slot, title, moves: f.moves.filter((m) => m.slot === slot) })).filter((g) => g.moves.length);
const dir = rigDir(f);
const backdrop = await stageBackdrop(f.matches.at(-1)?.rounds[0]?.stage);
const vt = `f-${f.id.replace(/[^a-z0-9_-]/gi, '_')}`;
const abilities = f.versions.at(-1)?.abilities ?? [];
const agent = f.agent ? [agentName(f.agent.tool), f.agent.model, f.agent.effort && `уровень рассуждений ${f.agent.effort}`].filter(Boolean).join(', ') : null;
---
<Page title={f.name} description={f.motto ? `${f.name}, боец модели ${f.model}. ${f.motto}` : `${f.name}, боец модели ${f.model}.`}>
  <div class="wrap" style={`--c:${f.color}`}>
    <header class="head" style={backdrop ? `--stage:url('${to(path, backdrop)}')` : undefined}>
      <div class="pic" style={`view-transition-name:${vt}`}><Figure fighter={f} play="intro" width={460} sizes="(max-width: 820px) 92vw, 460px" eager /></div>
      <div class="about">
        <h1 class="slab">{f.name}</h1>
        {f.motto && <p class="motto">{f.motto}</p>}
        <dl class="facts">
          <div><dt>Модель</dt><dd class="model">{f.model}</dd></div>
          {agent && <div><dt>Агент</dt><dd>{agent}</dd></div>}
          {f.author && <div><dt>Автор</dt><dd>{f.authorUrl ? <a href={f.authorUrl}>{f.author}</a> : f.author}</dd></div>}
        </dl>
        {f.stats && (
          <dl class="stats" data-rise>
            {STATS.map(([key, title], k) => (
              <div style={`--k:${k}`}>
                <dt>{title}</dt>
                <dd class="gauge" aria-label={`${f.stats?.[key]} из 5`}>{[1, 2, 3, 4, 5].map((i) => <i class:list={{ on: i <= (f.stats?.[key] ?? 0) }}></i>)}</dd>
              </div>
            ))}
          </dl>
        )}
        <div class="steps">
          <a class="plate primary" href={to(path, playAgainst(f))} data-hands>Сразиться</a>
          <a class="plate" href={to(path, setAgainst(f))}>Стравить с…</a>
          {f.matches.length > 0 && <a class="plate" href="#bouts">Смотреть бои</a>}
        </div>
      </div>
    </header>

    {groups.length > 0 && (
      <section class="movelist" data-moves={dir ? '' : undefined} data-dir={dir}>
        <h2 class="slab">Приёмы</h2>
        <div class="moves">
          {dir && <div class="ring" data-moves-stage aria-hidden="true"></div>}
          <div class="groups">
            {groups.map((g) => (
              <div class:list={['group', g.slot]}>
                <h3 class="slab">{g.title}</h3>
                <ul>
                  {g.moves.map((m) => (
                    <li>
                      <button class="move" type="button" data-move={m.id}>
                        <svg class="move-go" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 1.5v13l11-6.5z" /></svg>
                        <span class="move-name slab">{m.name}</span>
                        {m.kitName && m.kitName !== m.name && <span class="kit">{m.kitName}</span>}
                        {m.command && <span class="cmd" aria-label={`Команда ${m.command}`}>{commandGlyphs(m.command).map((g) => <span class={g.kind}>{g.text}</span>)}</span>}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {(f.story || abilities.length > 0) && (
      <div class="cols">
        {f.story && (
          <section class="story">
            <h2 class="slab">Предыстория</h2>
            <p>{f.story}</p>
          </section>
        )}
        {abilities.length > 0 && (
          <section>
            <h2 class="slab">Способности</h2>
            <ul class="abilities">
              {abilities.map((a, i) => <li data-rise style={`--i:${i}`}><b class="slab">{a.name}</b>{a.about && <p>{a.about}</p>}</li>)}
            </ul>
          </section>
        )}
      </div>
    )}

    {f.matches.length > 0 && (
      <section id="bouts">
        <h2 class="slab">Бои</h2>
        <div class="bouts">{f.matches.map((m) => <MatchCard season={seasonOf(m.season)} match={m} />)}</div>
      </section>
    )}

    {history && <section>
      <h2 class="slab">Версии</h2>
      <ol class="versions">
        {f.versions.map((v) => (
          <li>
            <h3 class="slab">Версия {v.v}</h3>
            {v.rounds.length > 0 && <p class="fought">{v.rounds.map((r) => `${r.match.title}, ${roundTitle(r.round).toLowerCase()}`).join('; ')}</p>}
            {(v.renamed || v.changes.length > 0 || v.added.length > 0 || v.removed.length > 0) && (
              <ul class="changes">
                {v.renamed && <li>Новое имя: {v.renamed[1]} вместо {v.renamed[0]}</li>}
                {v.changes.map((c) => <li><code>{c.file}</code> {c.lines}</li>)}
                {v.added.map((file) => <li><code>{file}</code> добавлен</li>)}
                {v.removed.map((file) => <li><code>{file}</code> удалён</li>)}
              </ul>
            )}
            {v.note && (
              <figure class="said">
                <figcaption>{f.model} в раздевалке после раунда {v.note.afterRound}</figcaption>
                <blockquote set:html={v.note.html} />
              </figure>
            )}
          </li>
        ))}
      </ol>
    </section>}
  </div>
</Page>

<style>
  /* the fighter on its stage, as on the game's card */
  .head { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); align-items: center; padding-top: clamp(4px, 1vw, 16px); }
  .head::before { content: ''; position: absolute; inset: -110px calc(50% - 50vw) -40px; z-index: -1; background: linear-gradient(180deg, var(--bg) 0%, rgba(6, 7, 11, .3) 35%, var(--bg) 100%), linear-gradient(270deg, rgba(6, 7, 11, .94) 0%, rgba(6, 7, 11, .45) 80%), var(--stage, none) center 40% / cover no-repeat; opacity: .7; }
  .pic { position: relative; height: clamp(420px, 46vw, 600px); background: repeating-linear-gradient(104deg, rgba(255, 255, 255, .05) 0 2px, transparent 2px 24px), radial-gradient(60% 70% at 50% 62%, color-mix(in srgb, var(--c) 62%, #05060a), color-mix(in srgb, var(--c) 10%, #05060a) 78%); clip-path: polygon(34px 0, 100% 0, calc(100% - 34px) 100%, 0 100%); }
  .about h1 { font-size: clamp(40px, 5.8vw, 82px); overflow-wrap: anywhere; text-shadow: 0 .05em 0 color-mix(in srgb, var(--c) 60%, #000); }
  .motto { margin: 18px 0 0; font: italic 500 clamp(20px, 2.1vw, 27px)/1.3 var(--display); color: color-mix(in srgb, var(--c) 70%, #fff); max-width: 26ch; animation: dash .4s var(--snap) .2s both; }
  .facts { display: grid; gap: 8px; margin: 24px 0 0; animation: dash .4s var(--snap) .26s both; }
  .facts div { display: grid; grid-template-columns: 5.5em 1fr; gap: 12px; align-items: baseline; }
  .facts dt { color: var(--mute); font-size: 15px; }
  .facts dd { margin: 0; }
  .facts .model { font-weight: 600; }
  .stats { margin: 26px 0 0; display: grid; gap: 11px; max-width: 360px; }
  .stats div { display: grid; grid-template-columns: 6.5em 1fr; align-items: center; gap: 12px; }
  .stats dt { font-size: 15px; color: #d6d9e3; }

  /* the move list: a ring with the fighter and a list of keys; a move under the pointer plays on the figure */
  .moves { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  .ring { position: sticky; top: 16px; height: min(560px, calc(100vh - 32px)); overflow: hidden; background: linear-gradient(0deg, rgba(0, 0, 0, .55) 0%, transparent 16%), repeating-linear-gradient(104deg, rgba(255, 255, 255, .05) 0 2px, transparent 2px 24px), linear-gradient(160deg, color-mix(in srgb, var(--c) 46%, #07080c) -10%, #07080c 72%); clip-path: polygon(30px 0, 100% 0, calc(100% - 30px) 100%, 0 100%); }
  .ring :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .groups { display: grid; gap: 26px; min-width: 0; }
  .group h3 { margin-bottom: 8px; font-size: 18px; letter-spacing: .08em; color: var(--dim); }
  .group.super h3 { color: var(--gold); }
  .group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; }
  .move { position: relative; display: grid; grid-template-columns: 14px minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: 0 12px; align-items: center; width: 100%; min-height: 54px; padding: 8px 22px 8px 18px; border: 0; text-align: left; color: var(--ink); font: inherit; background: var(--panel2); clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); cursor: pointer; isolation: isolate; transition: transform .14s var(--snap), color .1s; }
  .move::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 30%, #151821)); transform: scaleX(0); transform-origin: left; transition: transform .18s var(--snap); }
  .group.super .move::before { background: linear-gradient(180deg, #ffe27a, #ffb02a 48%, #e2621a 52%, #ffb02a); }
  .move:hover, .move.on, .move:focus-visible { transform: translateX(8px); }
  .move:hover::before, .move.on::before, .move:focus-visible::before { transform: none; }
  .move:active { filter: brightness(1.6); }
  .move-go { grid-row: 1 / span 2; width: 14px; height: 14px; fill: var(--mute); }
  .move.on .move-go, .move:hover .move-go { fill: #fff; }
  .move-name { grid-column: 2; font-size: 20px; line-height: 1.1; letter-spacing: .02em; }
  .kit { grid-column: 2; font-size: 13.5px; line-height: 1.25; color: var(--dim); }
  .move:hover .kit, .move.on .kit { color: rgba(255, 255, 255, .85); }
  .group.super .move:is(:hover, .on, :focus-visible) { color: #160a04; }
  .group.super .move:is(:hover, .on, :focus-visible) :is(.kit, .move-go) { color: #3a1c05; fill: #160a04; }
  .cmd { grid-column: 3; grid-row: 1 / span 2; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .cmd span { display: grid; place-items: center; min-width: 30px; height: 30px; font: 700 17px/1 var(--text); color: var(--ink); background: #05060a; border: 1px solid #3a3f4f; border-bottom-width: 3px; border-radius: 6px; }
  .cmd .hold { border-color: var(--gold); color: var(--gold); }
  .cmd .btn { min-width: 34px; padding: 0 7px; border-radius: 16px; font-size: 14px; color: #160a04; background: var(--gold); border-color: #a85a12; }

  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 clamp(32px, 6vw, 88px); }
  .cols > :only-child { grid-column: 1 / -1; }
  .abilities { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .abilities li { padding: 14px 20px 14px 18px; background: var(--panel); border-left: 5px solid var(--c); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%); }
  .abilities b { display: block; font-size: 19px; }
  .abilities p { margin: 6px 0 0; font-size: 15.5px; color: #d6d9e3; }
  .bouts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 28px; align-items: start; }

  .versions { list-style: none; margin: 0; padding: 0; border-left: 3px solid var(--c); }
  .versions > li { position: relative; padding: 0 0 36px clamp(18px, 3vw, 32px); }
  .versions > li:last-child { padding-bottom: 0; }
  .versions > li::before { content: ''; position: absolute; left: -9px; top: 6px; width: 15px; height: 15px; background: var(--c); transform: skewX(-18deg); }
  .fought { margin: 6px 0 0; color: var(--dim); font-size: 15.5px; }
  .changes { margin: 10px 0 0; padding: 0; list-style: none; font-size: 15.5px; }
  .said { margin: 16px 0 0; max-width: 72ch; }
  .said figcaption { font-size: 14.5px; color: var(--mute); margin-bottom: 8px; }
  .said blockquote { margin: 0; padding: 18px 22px 2px; background: var(--panel); }
  .said blockquote :global(a) { color: var(--gold); }
  .said blockquote :global(ol), .said blockquote :global(ul) { margin: 0 0 1em; padding-left: 1.3em; }
  .said blockquote :global(li) { margin-bottom: .5em; }
  .said blockquote :global(.scroll) { overflow-x: auto; margin: 0 0 1em; }
  .said blockquote :global(table) { border-collapse: collapse; font-size: 15px; font-variant-numeric: tabular-nums; }
  .said blockquote :global(th) { text-align: left; font-weight: 500; color: var(--mute); padding: 0 18px 6px 0; }
  .said blockquote :global(td) { padding: 6px 18px 6px 0; border-top: 1px solid var(--line); }

  @media (max-width: 820px) {
    .head { grid-template-columns: 1fr; gap: 0; }
    .pic { height: min(104vw, 440px); margin: 0 -6px; clip-path: polygon(18px 0, 100% 0, calc(100% - 18px) 100%, 0 100%); }
    .about { margin-top: -34px; position: relative; }
    .cols { grid-template-columns: 1fr; }
    .moves { grid-template-columns: 1fr; gap: 14px; }
    /* the fighter already stands in the head of the page, so the ring is not shown twice: it comes up from the
       bottom edge when a move is pressed and stays there while the list scrolls */
    .ring { order: 2; top: auto; bottom: 0; z-index: 3; display: none; height: 38vh; min-height: 240px; margin: 0 calc(var(--gutter) * -1); clip-path: none; border-top: 3px solid var(--c); background-color: #07080c; }
    .movelist:global(.playing) .ring { display: block; animation: rise .28s var(--snap) both; }
    .move:hover, .move.on, .move:focus-visible { transform: translateX(4px); }
    .move-name { font-size: 18px; }
    /* a long command goes under the name */
    .group:not(.normal) .cmd { grid-column: 2 / -1; grid-row: auto; margin-top: 5px; }
    .cmd span { min-width: 26px; height: 26px; font-size: 15px; }
    .bouts { grid-template-columns: 1fr; }
    .said blockquote { padding: 16px 16px 1px; }
  }
</style>

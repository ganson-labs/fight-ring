---
// The fighter select: tiles of every fighter and one large stage with the fighter under the pointer, alive.
import Page from '../../layouts/Page.astro';
import FighterCard from '../../components/FighterCard.astro';
import Figure from '../../components/Figure.astro';
import Finder from '../../components/Finder.astro';
import { ROSTER_TITLE, rating, roster, seasons } from '../../data/ring';
import type { StatKey } from '../../data/ring';
import { to } from '../../lib/paths';

// one section for the shared roster and one for every tournament whose fighters were made for it
const sections = [
  { title: ROSTER_TITLE, fighters: await roster() },
  ...(await seasons()).map((s) => ({ title: s.title, fighters: s.fighters.filter((f) => f.home) })),
].filter((s) => s.fighters.length > 0);
// A long list gets smaller tiles and a finder: search, a filter by model, the order. With the common rating at hand
// the fighters stand by it, the strongest first.
const all = sections.flatMap((s) => s.fighters);
const many = all.length > 12;
const rate = new Map(((await rating())?.rows ?? []).map((r) => [r.id, r.rating]));
if (many && rate.size) for (const s of sections) s.fighters = [...s.fighters].sort((a, b) => (rate.get(b.id) ?? 0) - (rate.get(a.id) ?? 0));
const first = sections[0]?.fighters[0];
const models = [...all.reduce((m, f) => m.set(f.model, (m.get(f.model) ?? 0) + 1), new Map<string, number>())].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ru'));
const STATS: [StatKey, string][] = [['health', 'Здоровье'], ['power', 'Сила'], ['speed', 'Скорость'], ['defense', 'Защита']];
---
<Page title="Бойцы" description="Бойцы, которых создали нейросети: портрет, модель, приёмы и версии.">
  <div class="wrap select">
    <h1 class="slab"><span class="hot">Бойцы</span></h1>
    {first && (
      <div class="preview" data-select style={`--c:${first.color}`}>
        <a class="stage" data-p="link" href={to(Astro.url.pathname, `fighters/${first.id}/`)} tabindex="-1" aria-hidden="true">
          <Figure fighter={first} part="fig" play="intro" width={460} sizes="(max-width: 900px) 90vw, 460px" eager />
        </a>
        <div class="info hit" data-p="who">
          <p class="name slab" data-p="name">{first.name}</p>
          <p class="model" data-p="model">{first.model}</p>
          <p class="author" data-p="author">{first.author}</p>
          <p class="motto" data-p="motto">{first.motto}</p>
          <dl class="stats">
            {STATS.map(([key, title], k) => (
              <div style={`--k:${k}`}><dt>{title}</dt><dd class="gauge" data-stat={key}>{[1, 2, 3, 4, 5].map((i) => <i class:list={{ on: i <= (first.stats?.[key] ?? 0) }}></i>)}</dd></div>
            ))}
          </dl>
          <a class="plate primary" data-p="link" href={to(Astro.url.pathname, `fighters/${first.id}/`)}>Открыть бойца</a>
        </div>
      </div>
    )}
    <div class="sets" id="fighters">
      {many && <Finder list="fighters" models={models} sorts={rate.size ? ['top', 'new', 'name'] : ['new', 'name']} />}
      {sections.map((s) => (
        <section data-group>
          {sections.length > 1 && <h2 class="slab">{s.title}</h2>}
          <div class:list={['grid', { many: s.fighters.length > 12 }]}>
            {s.fighters.map((f) => (s.fighters.length > 12
              ? <FighterCard fighter={f} width={132} sizes="(max-width: 900px) 22vw, 132px" selected={f === first} rating={rate.get(f.id)} plain />
              : <FighterCard fighter={f} width={240} sizes="(max-width: 900px) 30vw, 240px" selected={f === first} rating={rate.get(f.id)} />))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Page>

<style>
  .select { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); grid-template-areas: 'title title' 'preview sets'; gap: 0 clamp(24px, 4vw, 56px); align-items: start; }
  h1 { grid-area: title; padding: clamp(8px, 2vw, 24px) 0 clamp(20px, 3vw, 36px); }
  .preview { grid-area: preview; position: sticky; top: 16px; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; min-height: min(600px, calc(100vh - 150px)); isolation: isolate; }
  .preview::before { content: ''; position: absolute; inset: 0; z-index: -1; background: repeating-linear-gradient(104deg, rgba(255, 255, 255, .05) 0 2px, transparent 2px 24px), radial-gradient(60% 70% at 30% 60%, color-mix(in srgb, var(--c) 62%, #05060a), color-mix(in srgb, var(--c) 12%, #05060a) 75%); clip-path: polygon(34px 0, 100% 0, calc(100% - 34px) 100%, 0 100%); transition: background .2s; }
  .stage { position: relative; align-self: stretch; display: block; margin: -6% -14% 0 -2%; }
  .info { position: relative; }
  .info { padding: 28px clamp(28px, 4vw, 52px) 34px 0; min-width: 0; }
  .info :global(.plate) { white-space: nowrap; padding-inline: 26px; }
  .name { margin: 0; font-size: clamp(28px, 2.9vw, 42px); overflow-wrap: break-word; text-shadow: 0 3px 0 rgba(0, 0, 0, .5); }
  .model { margin: 10px 0 0; font-weight: 600; color: color-mix(in srgb, var(--c) 60%, #fff); }
  .author { margin: 2px 0 0; font-size: 15px; color: #d6d9e3; }
  .author:empty { display: none; }
  .motto { margin: 14px 0 0; font: italic 500 19px/1.3 var(--display); color: #e7e9f0; min-height: 2.6em; }
  .stats { margin: 22px 0 26px; display: grid; gap: 10px; }
  .stats div { display: grid; grid-template-columns: 6em 1fr; align-items: center; gap: 10px; font-size: 15px; }
  .stats dt { color: #d6d9e3; }
  .info.hit .name { transform-origin: 0 60%; animation: slam .34s cubic-bezier(.2, .9, .3, 1) both; }
  .info.hit .gauge :global(i.on) { transform-origin: left; animation: fill .26s var(--snap) calc(var(--k) * 50ms + .1s) both; }

  .sets { grid-area: sets; min-width: 0; }
  .sets h2 { margin-top: 0; }
  .sets section + section { margin-top: 48px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 2.6vw, 32px) clamp(12px, 1.6vw, 22px); padding: 8px 6px; }
  /* hundreds of fighters: five in a row, the name alone under the portrait (the model and the author are in the preview) */
  .grid.many { grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 18px 10px; }
  .grid.many :global(.tile-plate) { margin-top: 7px; padding-left: 8px; border-left-width: 3px; }
  .grid.many :global(.tile-name) { font-size: 14px; }
  .grid.many :global(.tile-model), .grid.many :global(.tile-author) { display: none; }
  .sets :global([hidden]) { display: none !important; }

  @media (max-width: 900px) {
    .select { grid-template-columns: 1fr; grid-template-areas: 'title' 'preview' 'sets'; }
    .preview { position: relative; top: 0; grid-template-columns: 1fr; min-height: 0; margin: 0 -6px 26px; }
    .preview::before { clip-path: polygon(18px 0, 100% 0, calc(100% - 18px) 100%, 0 100%); bottom: 34px; }
    .stage { height: min(78vw, 330px); margin: 0; }
    .info { padding: 0 26px 0 22px; margin-top: -22px; }
    .name { font-size: clamp(30px, 9vw, 44px); }
    .motto { min-height: 0; font-size: 17px; }
    .stats { margin: 14px 0 18px; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
    .stats div { grid-template-columns: 1fr; gap: 3px; font-size: 13.5px; }
    .info :global(.plate) { width: 100%; }
  }
</style>

---
import Page from '../layouts/Page.astro';
import FighterCard from '../components/FighterCard.astro';
import MatchCard from '../components/MatchCard.astro';
import { PLAY, fighterIn, latestSeason, plural } from '../data/ring';
import { to } from '../lib/paths';
import { stageBackdrop } from '../lib/rig';

const season = await latestSeason();
const path = Astro.url.pathname;
const final = season.final;
const winner = final?.winner ? fighterIn(season, final.winner) : null;
const backdrop = await stageBackdrop(final?.rounds[0]?.stage);
const n = season.fighters.length;
const lead = 'Это файтинг, в котором бойцов создают нейросети. Модель сама придумывает персонажа, рисует его, выбирает приёмы и голос и пишет программу, которая ведёт бойца в бою.';
---
<Page description={lead}>
  <section class="hero" style={backdrop ? `--stage:url('${to(path, backdrop)}')` : undefined}>
    <div class="wrap hero-in">
      <div class="hero-text">
        <h1 class="slab"><span class="hot">Ринг моделей</span></h1>
        <p class="lead">{lead}</p>
        <p class="lead">
          {season.title}: {n} {plural(n, 'боец', 'бойца', 'бойцов')}.{' '}
          {final && winner && <>Финал выиграл боец «{winner.name}» модели {winner.model} со счётом {Math.max(...final.score)}:{Math.min(...final.score)}.</>}
        </p>
        <div class="steps">
          <a class="plate primary" href={to(path, 'tournament/')}>Смотреть турнир</a>
          <div class="more">
            <a class="plate" href={to(path, PLAY)}>Играть самому</a>
            <a class="plate" href={to(path, 'enter/')}>Выставить свою модель</a>
          </div>
        </div>
      </div>
      {final && <div class="duel"><MatchCard season={season} match={final} heading="h2" rounds={false} href={to(path, 'tournament/')} /></div>}
    </div>
  </section>

  <section class="wrap">
    <h2 class="slab">Бойцы</h2>
    <div class="row">
      {season.fighters.map((f, i) => <div class="cell" data-rise="up" style={`--i:${i}`}><FighterCard fighter={f} width={230} sizes="(max-width: 700px) 30vw, 230px" /></div>)}
    </div>
  </section>
</Page>

<style>
  .hero { position: relative; isolation: isolate; padding: clamp(12px, 3vw, 48px) 0 clamp(24px, 4vw, 56px); }
  .hero::before { content: ''; position: absolute; inset: -120px 0 0; z-index: -1; background: linear-gradient(180deg, var(--bg) 0%, transparent 22%, transparent 55%, var(--bg) 100%), linear-gradient(90deg, rgba(6, 7, 11, .9) 0%, rgba(6, 7, 11, .5) 100%), var(--stage, none) center 30% / cover no-repeat; filter: saturate(1.1); opacity: .75; }
  .hero-in { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .hero-text h1 { margin-bottom: 26px; font-size: clamp(46px, 6.6vw, 96px); }
  .hero-text .lead + .lead { color: var(--dim); font-size: 17px; }
  .hero .steps { flex-direction: column; align-items: flex-start; gap: 14px; }
  .more { display: flex; flex-wrap: wrap; gap: 12px 6px; }
  .duel { min-width: 0; transform: rotate(-1.2deg); }
  .duel :global(.vs-stage) { aspect-ratio: 4 / 3; box-shadow: 0 30px 80px -20px #000, 0 0 70px -14px rgba(255, 176, 42, .5); }

  .row { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(22px, 2.6vw, 34px) clamp(10px, 2vw, 26px); }
  .cell { flex: 0 1 calc((100% - 4 * clamp(10px, 2vw, 26px)) / 5); min-width: 0; }

  @media (max-width: 880px) {
    .hero-in { grid-template-columns: 1fr; }
    .hero-text { display: contents; }
    .hero-text h1 { order: -2; margin-bottom: 0; }
    .duel { order: -1; transform: none; margin: 0 calc(var(--gutter) * -1 + 6px); }
    .duel :global(.vs-stage) { aspect-ratio: 1; }
    .hero .steps { align-items: stretch; }
    .more { flex-direction: column; }
    .cell { flex-basis: calc((100% - 2 * clamp(10px, 2vw, 26px)) / 3); }
  }
</style>

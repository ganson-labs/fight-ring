---
import '../styles/site.css';
import { SITE } from '../data/site';
import { PLAY, WATCH } from '../data/ring';
import { root, to } from '../lib/paths';

interface Props {
  title?: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: 'tournament/', text: 'Турнир' },
  { href: 'fighters/', text: 'Бойцы' },
  { href: 'rating/', text: 'Рейтинг' },
  { href: PLAY, text: 'Играть самому', hands: true },
  { href: WATCH, text: 'Стравить модели' },
  { href: 'enter/', text: 'Свой боец' },
];
const current = (href: string) => !href.startsWith('play/') && path.startsWith(`/${href}`);
const r = root(path);
// the game's renderer, for the live fighters (ui/live.js): the same files the game itself loads from play/
const imports = JSON.stringify({ imports: { 'pixi.js': `${r}kit/arena/vendor/pixi.mjs`, 'pixi-filters': `${r}kit/arena/vendor/pixi-filters.mjs` } });
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} — ${SITE.name}` : SITE.name}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#06070b" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Cpath d=%22M3 13 13 3M3 3l10 10%22 stroke=%22%23f3c64d%22 stroke-width=%222.5%22/%3E%3C/svg%3E" />
    <script is:inline>
      // before the first paint: the pages may hide what comes in with a hit, and the sound switch shows its state
      document.documentElement.classList.add('js');
      // the script that brings those blocks in did not load: nothing stays hidden (an onerror attribute would be
      // an inline script, which the site's Content-Security-Policy does not let run)
      addEventListener('error', function (e) { if (e.target && /ui\/arcade\.js/.test(e.target.src || '')) document.documentElement.classList.remove('js'); }, true);
      try { document.documentElement.dataset.audio = JSON.parse(localStorage.getItem('ring.settings') || '{}').sound === false ? 'off' : 'on'; } catch (e) {}
    </script>
    <script is:inline type="importmap" set:html={imports}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&family=Oswald:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline type="module" src={`${r}ui/arcade.js`}></script>
    <script is:inline type="module" src={`${r}ui/live.js`}></script>
  </head>
  <body>
    <header class="wrap top">
      <a class="logo" href={root(path)}><span class="hot">{SITE.name}</span></a>
      <nav class="nav" aria-label="Разделы">
        {nav.map((n) => <a href={to(path, n.href)} aria-current={current(n.href) ? 'page' : undefined} data-hands={n.hands || undefined}>{n.text}</a>)}
      </nav>
      <button class="sound" type="button" data-sound aria-pressed="true" aria-label="Звук">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="spk" d="M3 9.5h4l5-4.5v14l-5-4.5H3z" /><path class="on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /><path class="off" d="m15.5 9.5 5 5m0-5-5 5" /></svg>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <footer class="wrap foot">
      <a href={SITE.channel} target="_blank" rel="noopener">Канал «гансон:» на YouTube</a>
      <a href={SITE.repo}>Код ринга на GitHub</a>
    </footer>
  </body>
</html>

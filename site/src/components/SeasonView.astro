---
// A season as the game would show it: the champion on the stage, the bracket with the winners' way to the final,
// the league as a ladder of power bars, what the models spent as their bills.
import type { Season } from '../data/ring';
import { dateRu, fighterIn, num, plural, watchRound } from '../data/ring';
import { to } from '../lib/paths';
import { stageBackdrop } from '../lib/rig';
import Figure from './Figure.astro';
import MatchCard from './MatchCard.astro';
import Portrait from './Portrait.astro';

interface Props { season: Season }
const { season } = Astro.props;
const path = Astro.url.pathname;
const semis = season.matches.filter((m) => m.kind === 'semi');
const final = season.final;
const rest = season.matches.filter((m) => m.kind !== 'semi' && m.kind !== 'final');
const firstRound = final?.rounds[0];
const champion = final?.winner ? fighterIn(season, final.winner) : null;
const backdrop = await stageBackdrop(final?.rounds.at(-1)?.stage);
const color = (cid: string | null) => (cid ? fighterIn(season, cid)?.color : null) ?? 'var(--line)';

const league = season.league;
// the bars start a little before the weakest fighter, so its bar is still a bar
const lo = league ? league.min - (league.max - league.min) * 0.12 : 0;
const span = league ? league.max - lo || 1 : 1;
const pct = (v: number) => (((v - lo) / span) * 100).toFixed(2);
const spend = season.spend;
const most = spend ? Math.max(...spend.rows.map((r) => r.minutes + (r.lockerMinutes ?? 0)), 1) : 1;
---
<div class="wrap">
  <header class="champ" style={`--c:${champion?.color ?? 'var(--gold)'};${backdrop ? `--stage:url('${to(path, backdrop)}')` : ''}`}>
    <div class="champ-text">
      <h1 class="slab"><span class="hot">{season.title.replace(/-/g, '‑')}</span></h1>
      <p class="dim date">{dateRu(season.published)}</p>
      {champion && (
        <p class="champ-who" data-rise>
          <span class="champ-tag slab">Чемпион</span>
          <a class="champ-name slab" href={to(path, `fighters/${champion.id}/`)}>{champion.name}</a>
          <span class="champ-model">{champion.model}</span>
        </p>
      )}
      {final && firstRound && <div class="steps"><a class="plate primary" href={to(path, watchRound(final, firstRound))}>Смотреть финал</a></div>}
    </div>
    {champion && (
      <a class="champ-fig" href={to(path, `fighters/${champion.id}/`)} aria-label={champion.name} tabindex="-1">
        <span class="rays" aria-hidden="true"></span>
        <Figure fighter={champion} play="victory" again={7} width={420} sizes="(max-width: 880px) 80vw, 420px" eager />
      </a>
    )}
  </header>

  <section aria-label="Сетка">
    <div class:list={['bracket', { paired: semis.length === 2 && final }]}>
      <div class="semis">{semis.map((m) => <div class="seed" style={`--w:${color(m.winner)}`}><MatchCard season={season} match={m} heading="h2" /></div>)}</div>
      {final && <div class="final" style={`--w1:${color(semis[0]?.winner ?? null)};--w2:${color(semis[1]?.winner ?? null)}`}><MatchCard season={season} match={final} heading="h2" /></div>}
    </div>
    {rest.length > 0 && <div class="rest">{rest.map((m) => <MatchCard season={season} match={m} heading="h2" />)}</div>}
  </section>

  {league && (
    <section id="league">
      <h2 class="slab">Лига</h2>
      <p class="fact">Все бойцы сыграли друг с другом: {num(league.fights)} {plural(league.fights, 'бой', 'боя', 'боёв')}.</p>
      <ol class="ladder">
        {league.rows.map((r, i) => {
          const f = r.isReference ? null : fighterIn(season, r.id);
          return (
            <li class:list={['rung', { ref: r.isReference }]} data-rise style={`--c:${r.color ?? 'var(--mute)'};--i:${Math.min(i, 8)}`}>
              <span class="rank slab">{i + 1}</span>
              <span class="face">{f && <Portrait fighter={f} width={56} alt="" />}</span>
              <span class="rung-who">
                {f ? <a class="rung-name slab" href={to(path, `fighters/${f.id}/`)}>{r.name}</a> : <b class="rung-name slab">{r.name}</b>}
                <span class="rung-model">{r.isReference ? 'Эталонный боец ринга' : r.model}</span>
              </span>
              <span class="rung-bar" aria-hidden="true">
                <span class="power" style={`width:${pct(r.rating)}%`}></span>
                <span class="band" style={`left:${pct(r.range[0])}%;width:${(Number(pct(r.range[1])) - Number(pct(r.range[0]))).toFixed(2)}%`}></span>
              </span>
              <span class="rung-rating"><b class="slab" data-count={r.rating}>{num(r.rating)}</b><span class="range">{num(r.range[0])}–{num(r.range[1])}</span></span>
              <span class="rung-stat"><b>{Math.round(r.share * 100)}&nbsp;%</b> очков</span>
              <span class="rung-stat"><b>{num(r.kos)}</b> {plural(r.kos, 'нокаут', 'нокаута', 'нокаутов')}</span>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  {spend && (
    <section id="spend">
      <h2 class="slab">Расходы моделей</h2>
      <ul class="bills">
        {spend.rows.map((r, i) => (
          <li class="bill" data-rise="up" style={`--c:${r.color ?? 'var(--mute)'};--i:${i}`}>
            <b class="bill-model slab">{r.model}</b>
            <span class="bill-price slab"><span class="hot">{r.price}</span></span>
            <span class="bill-bar" aria-hidden="true">
              <span class="made" style={`width:${((r.minutes / most) * 100).toFixed(1)}%`}></span>
              {r.lockerMinutes !== null && <span class="locker" style={`width:${((r.lockerMinutes / most) * 100).toFixed(1)}%`}></span>}
            </span>
            <dl>
              <div><dt>Создание бойца</dt><dd>{r.minutes} мин</dd></div>
              <div><dt>Раздевалки</dt><dd>{r.lockerMinutes === null ? '—' : `${r.lockerMinutes} мин`}</dd></div>
              <div><dt>Написано токенов</dt><dd>{r.tokens}</dd></div>
            </dl>
          </li>
        ))}
      </ul>
      {spend.note && <p class="dim note">{spend.note}</p>}
    </section>
  )}
</div>

<style>
  /* ---------- the champion ---------- */
  .champ { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 0 clamp(16px, 3vw, 48px); align-items: center; padding: clamp(8px, 2vw, 24px) 0 clamp(36px, 5vw, 64px); }
  .champ::before { content: ''; position: absolute; inset: -110px calc(50% - 50vw) 0; z-index: -1; background: linear-gradient(180deg, var(--bg) 0%, rgba(6, 7, 11, .2) 30%, rgba(6, 7, 11, .55) 70%, var(--bg) 100%), linear-gradient(90deg, rgba(6, 7, 11, .92) 0%, rgba(6, 7, 11, .35) 70%), var(--stage, none) center 40% / cover no-repeat; opacity: .8; }
  .champ h1 { font-size: clamp(30px, 4.2vw, 56px); }
  .date { margin: 10px 0 0; }
  .champ-who { display: flex; flex-direction: column; align-items: flex-start; margin: clamp(22px, 3.4vw, 44px) 0 0; max-width: none; }
  .champ-tag { padding: 6px 22px 5px 14px; font-size: clamp(15px, 1.5vw, 19px); letter-spacing: .12em; color: #160a04; background: linear-gradient(180deg, #ffe27a, #ffb02a 48%, #e2621a 52%, #ffb02a); clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
  .champ-name { margin-top: 10px; font-size: clamp(50px, 8.6vw, 124px); line-height: .92; text-decoration: none; color: #fff; text-shadow: 0 .04em 0 color-mix(in srgb, var(--c) 70%, #000), 0 0 .5em color-mix(in srgb, var(--c) 70%, transparent); overflow-wrap: anywhere; }
  .champ-name:hover { color: var(--gold); }
  .champ-model { margin-top: 14px; font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; color: color-mix(in srgb, var(--c) 70%, #fff); }
  .champ-fig { position: relative; display: block; height: clamp(360px, 44vw, 560px); }
  .champ-fig::after { content: ''; position: absolute; left: 8%; right: 8%; bottom: 0; height: 9%; background: radial-gradient(50% 50% at 50% 50%, color-mix(in srgb, var(--c) 75%, transparent), transparent 70%); z-index: -1; }
  /* the light behind a winner: slow rays in gold and in the fighter's colour */
  .rays { position: absolute; inset: -18% -30%; z-index: -1; background: repeating-conic-gradient(from 0deg at 50% 62%, color-mix(in srgb, var(--c) 50%, transparent) 0 6deg, transparent 6deg 15deg, rgba(255, 201, 74, .32) 15deg 19deg, transparent 19deg 30deg); -webkit-mask-image: radial-gradient(closest-side at 50% 62%, #000 0%, transparent 78%); mask-image: radial-gradient(closest-side at 50% 62%, #000 0%, transparent 78%); animation: rays 40s linear infinite; }
  @keyframes rays { to { transform: rotate(360deg); } }
  .rays { transform-origin: 50% 62%; }
  :global(html.js) .champ-who.in { animation: none; opacity: 1; }
  :global(html.js) .champ-who.in .champ-name { transform-origin: 8% 60%; animation: slam .55s cubic-bezier(.2, .9, .3, 1) .15s both; }
  :global(html.js) .champ-who.in :is(.champ-tag, .champ-model) { animation: dash .4s var(--snap) both; }

  /* ---------- the bracket ---------- */
  .bracket { display: grid; gap: 28px; }
  .semis { display: grid; gap: 28px; }
  .seed, .final { position: relative; min-width: 0; }
  .rest { display: grid; gap: 28px; margin-top: 56px; }
  /* the way to the final, in the colour of the one who went it. A narrow screen reads from top to bottom: a rail
     on the left edge runs from each semifinal down into the final */
  @media (max-width: 999px) {
    .bracket.paired .seed, .bracket.paired .final { padding-left: 16px; }
    .bracket.paired .seed::before { content: ''; position: absolute; left: 0; top: 14px; bottom: -28px; width: 5px; background: var(--w); transform: skewY(-24deg); transform-origin: top; box-shadow: 0 0 14px var(--w); }
    .bracket.paired .final::before { content: ''; position: absolute; left: 0; top: 0; bottom: 60%; width: 5px; background: linear-gradient(180deg, var(--w2), var(--gold)); box-shadow: 0 0 14px var(--gold); }
  }
  @media (min-width: 1000px) {
    .bracket.paired { grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1.22fr); gap: 0; align-items: center; }
    .bracket.paired .semis { gap: 44px; }
    .bracket.paired .final { grid-column: 3; }
    .bracket.paired .seed::after { content: ''; position: absolute; left: 100%; width: 32px; border: 5px solid var(--w); border-left: 0; filter: drop-shadow(0 0 8px var(--w)); }
    .bracket.paired .seed:first-child::after { top: 42%; height: calc(58% + 22px); border-bottom: 0; }
    .bracket.paired .seed:last-child::after { bottom: 58%; height: calc(42% + 22px); border-top: 0; }
    .bracket.paired .final::before { content: ''; position: absolute; right: 100%; top: 50%; width: 32px; height: 5px; margin-top: -2.5px; background: linear-gradient(180deg, var(--w1) 50%, var(--w2) 50%); filter: drop-shadow(0 0 8px var(--gold)); }
    .rest { grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1.22fr); gap: 0; }
  }

  /* ---------- the league: a ladder of power bars ---------- */
  .fact { color: var(--dim); margin: -12px 0 26px; }
  .ladder { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .rung { display: grid; grid-template-columns: 2.2ch 52px minmax(150px, 1.1fr) minmax(0, 2.2fr) 7.4ch 8.5ch 11ch; gap: 4px 18px; align-items: center; padding: 10px 22px 10px 14px; background: linear-gradient(90deg, color-mix(in srgb, var(--c) 20%, var(--panel)) 0%, var(--panel) 46%); clip-path: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%); font-variant-numeric: tabular-nums; }
  .rank { font-size: 34px; text-align: center; color: color-mix(in srgb, var(--c) 70%, #fff); }
  .rung:first-child .rank { background: var(--hot); -webkit-background-clip: text; background-clip: text; color: transparent; font-size: 44px; }
  .face { width: 52px; }
  .face :global(.frame) { padding: 2px; clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .face :global(img) { clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .rung-who { display: flex; flex-direction: column; min-width: 0; }
  .rung-name { font-size: 21px; line-height: 1.1; text-decoration: none; overflow-wrap: anywhere; }
  a.rung-name:hover { color: var(--gold); }
  .rung-model { font-size: 14px; font-weight: 500; color: color-mix(in srgb, var(--c) 62%, #fff); }
  .rung-bar { position: relative; height: 26px; background: rgba(255, 255, 255, .05); transform: skewX(-24deg); overflow: hidden; }
  .power { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--c) 45%, #000), var(--c)); box-shadow: 0 0 18px color-mix(in srgb, var(--c) 60%, transparent); transform-origin: left; }
  .power::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 4px; background: #fff; }
  /* the interval the rating lies in: a lighter stretch around the end of the bar */
  .band { position: absolute; top: 0; bottom: 0; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, .5) 0 2px, rgba(255, 255, 255, .14) 2px 6px); border-inline: 2px solid rgba(255, 255, 255, .85); }
  .rung-rating { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
  .rung-rating b { font-size: 30px; }
  .range { font-size: 13px; color: var(--dim); white-space: nowrap; }
  .rung-stat { display: flex; flex-direction: column; font-size: 13px; line-height: 1.2; color: var(--dim); }
  .rung-stat b { font: 600 17px/1.2 var(--text); color: var(--ink); }
  .rung.ref { background: var(--panel); }
  .rung.ref .rung-name { color: var(--dim); }
  .rung.ref .rank { color: var(--mute); }
  @keyframes grow { from { transform: scaleX(0); } }
  @keyframes fade { from { opacity: 0; } }
  :global(html.js) .rung.in .power { animation: grow .7s cubic-bezier(.2, .8, .2, 1) calc(var(--i) * 70ms + .15s) both; }
  :global(html.js) .rung.in .band { animation: fade .3s linear calc(var(--i) * 70ms + .8s) both; }

  /* ---------- what the models spent ---------- */
  .bills { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .bill { display: flex; flex-direction: column; padding: 18px 20px 16px; background: linear-gradient(180deg, color-mix(in srgb, var(--c) 24%, var(--panel)) 0%, var(--panel) 70%); border-top: 4px solid var(--c); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%); }
  .bill-model { font-size: 21px; color: color-mix(in srgb, var(--c) 55%, #fff); }
  .bill-price { margin-top: 10px; font-size: clamp(44px, 4.6vw, 60px); white-space: nowrap; }
  .bill-bar { display: flex; gap: 3px; height: 10px; margin: 16px 0 14px; transform: skewX(-24deg); }
  .made { background: var(--c); }
  .locker { background: color-mix(in srgb, var(--c) 45%, #fff); }
  .bill dl { margin: 0; display: grid; gap: 6px; font-size: 14px; }
  .bill dl div { display: flex; justify-content: space-between; gap: 12px; }
  .bill dt { color: var(--dim); }
  .bill dd { margin: 0; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .note { margin-top: 18px; font-size: 15px; }
  :global(html.js) .bill.in .bill-bar { transform-origin: left; animation: fill .5s var(--snap) calc(var(--i) * 70ms + .2s) both; }

  @media (max-width: 880px) {
    .champ { grid-template-columns: 1fr; }
    .champ-fig { height: min(96vw, 400px); margin: 8px 0 -8px; order: 0; }
    .champ-text { display: contents; }
    .champ h1 { order: -3; }
    .date { order: -2; }
    .champ-fig { order: -1; }
    .rung { grid-template-columns: 2ch 44px minmax(0, 1fr) auto; gap: 8px 12px; padding: 12px 20px 12px 12px; }
    .face { width: 44px; }
    .rank { font-size: 28px; }
    .rung-name { font-size: 18px; }
    .rung-rating b { font-size: 26px; }
    .rung-rating { grid-row: 1; grid-column: 4; }
    .rung-bar { grid-row: 2; grid-column: 1 / -1; height: 18px; }
    .rung-stat { grid-row: 3; grid-column: 1 / span 3; flex-direction: row; align-items: baseline; gap: 6px; padding-left: 6px; }
    .rung-stat:last-child { grid-column: 4; justify-content: flex-end; white-space: nowrap; }
  }
</style>
